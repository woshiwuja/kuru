// Zed tasks: https://zed.dev/docs/tasks
[
  {
    "label": "build",
    "command": "cmake -S . -B build && cmake --build build",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "build release",
    "command": "cmake -S . -B build-release -DCMAKE_BUILD_TYPE=Release && cmake --build build-release",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "build & run debug",
    "command": "cmake -S . -B build && cmake --build build && ./build/Kuru",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "build & run release",
    "command": "cmake -S . -B build-release -DCMAKE_BUILD_TYPE=Release && cmake --build build-release && ./build-release/Kuru",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    // Linux, bash. The viewer connects as soon as the engine is up (-a) and
    // outlives it (setsid), so the capture stays open to inspect.
    "label": "build & run release + tracy",
    "command": "cmake -S . -B build-release -DCMAKE_BUILD_TYPE=Release && cmake --build build-release && { setsid -f ./tracy-*-linux/tracy-profiler-*.AppImage -a 127.0.0.1; ./build-release/Kuru; }",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  }
]
