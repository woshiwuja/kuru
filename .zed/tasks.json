// Zed tasks: https://zed.dev/docs/tasks
[
  {
    "label": "build",
    "command": "cmake -S . -B build; if ($?) { cmake --build build }",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "build release",
    "command": "cmake -S . -B build-release -DCMAKE_BUILD_TYPE=Release; if ($?) { cmake --build build-release }",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "build & run debug",
    "command": "cmake -S . -B build; if ($?) { cmake --build build }; if ($?) { ./build/Kuru.exe }",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "build & run release",
    "command": "cmake -S . -B build-release -DCMAKE_BUILD_TYPE=Release; if ($?) { cmake --build build-release }; if ($?) { ./build-release/Kuru.exe }",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  }
]
